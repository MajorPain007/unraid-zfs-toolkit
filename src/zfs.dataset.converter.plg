<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name        "zfs.dataset.converter">
<!ENTITY author      "MajorPain007">
<!ENTITY version     "2025.04.12">
<!ENTITY launch      "Settings/ZFSDatasetConverter">
<!ENTITY pluginURL   "https://raw.githubusercontent.com/MajorPain007/zfs-dataset-converter/main/src/zfs.dataset.converter.plg">
<!ENTITY srcURL      "https://raw.githubusercontent.com/MajorPain007/zfs-dataset-converter/main/src">
<!ENTITY pluginDir   "/usr/local/emhttp/plugins/&name;">
<!ENTITY configDir   "/boot/config/plugins/&name;">
<!ENTITY tmpDir      "/tmp/&name;">
]>

<PLUGIN name="&name;" author="&author;" version="&version;" launch="&launch;"
        pluginURL="&pluginURL;"
        min="6.12.0"
        icon="database">

<CHANGES>
## Version 2025.04.12
- Add automatic schedule (cron) with hourly/6h/daily/weekly/custom options
- Cron job auto-restored on reboot via rc.d script
- Fix HTML entity encoding in log viewer
- Fix "Error" status badge when nothing to convert
- PHP error handlers always return JSON

## Version 2025.04.11
- Initial release
- Convert regular folders to ZFS child datasets
- Docker container and VM awareness (auto stop/start)
- Resume interrupted conversions
- Dry-run mode
- Real-time log viewer
- Unraid notification support
</CHANGES>

<!-- Create directories -->
<FILE Run="/bin/bash">
<INLINE>
mkdir -p &pluginDir;/scripts
mkdir -p &configDir;
mkdir -p &tmpDir;
</INLINE>
</FILE>

<!-- GUI page -->
<FILE Name="&pluginDir;/ZFSDatasetConverter.page">
<URL>&srcURL;/ZFSDatasetConverter.page</URL>
</FILE>

<!-- Backend scripts -->
<FILE Name="&pluginDir;/scripts/scan_folders.php">
<URL>&srcURL;/scripts/scan_folders.php</URL>
</FILE>

<FILE Name="&pluginDir;/scripts/start_conversion.php">
<URL>&srcURL;/scripts/start_conversion.php</URL>
</FILE>

<FILE Name="&pluginDir;/scripts/get_status.php">
<URL>&srcURL;/scripts/get_status.php</URL>
</FILE>

<FILE Name="&pluginDir;/scripts/get_logs.php">
<URL>&srcURL;/scripts/get_logs.php</URL>
</FILE>

<FILE Name="&pluginDir;/scripts/save_settings.php">
<URL>&srcURL;/scripts/save_settings.php</URL>
</FILE>

<FILE Name="&pluginDir;/scripts/zfs_converter.sh" Mode="755">
<URL>&srcURL;/scripts/zfs_converter.sh</URL>
</FILE>

<FILE Name="&pluginDir;/scripts/run_auto.sh" Mode="755">
<URL>&srcURL;/scripts/run_auto.sh</URL>
</FILE>

<FILE Name="&pluginDir;/scripts/setup_cron.sh" Mode="755">
<URL>&srcURL;/scripts/setup_cron.sh</URL>
</FILE>

<!-- rc.d script: recreate cron on every boot -->
<FILE Name="/etc/rc.d/rc.zfs-dataset-converter" Mode="755">
<INLINE>
#!/bin/bash
# Restore ZFS Dataset Converter cron job after boot
/usr/local/emhttp/plugins/zfs.dataset.converter/scripts/setup_cron.sh &gt;/tmp/zfs.dataset.converter/setup_cron.log 2&gt;&amp;1
</INLINE>
</FILE>

<!-- Default config (only written if not already present) -->
<FILE Run="/bin/bash">
<INLINE>
if [ ! -f &configDir;/settings.cfg ]; then
cat > &configDir;/settings.cfg &lt;&lt; 'EOF'
# ZFS Dataset Converter - default settings
dry_run=yes
cleanup=yes
replace_spaces=no
should_process_containers=yes
appdata_pool=cache
appdata_dataset=appdata
should_process_vms=no
vm_pool=cache
vm_dataset=domains
vm_forceshutdown_wait=90
buffer_zone=11
send_notifications=yes
validation_tolerance=5
extra_datasets=
cron_enabled=no
cron_preset=daily
cron_hour=2
cron_minute=0
cron_weekday=0
cron_custom=0 2 * * *
EOF
fi

# Apply cron from saved settings (if enabled)
/usr/local/emhttp/plugins/zfs.dataset.converter/scripts/setup_cron.sh &gt;/tmp/zfs.dataset.converter/setup_cron.log 2&gt;&amp;1
</INLINE>
</FILE>

<!-- Uninstall -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
# Remove cron job
rm -f /etc/cron.d/&name;
rm -f /etc/rc.d/rc.zfs-dataset-converter
if [ -f /var/run/crond.pid ]; then kill -HUP "$(cat /var/run/crond.pid)" 2>/dev/null; fi
rm -rf &pluginDir;
rm -rf &tmpDir;
echo "ZFS Dataset Converter removed. Settings in &configDir; preserved."
</INLINE>
</FILE>

</PLUGIN>
