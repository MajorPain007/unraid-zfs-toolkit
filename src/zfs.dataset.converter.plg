<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name        "zfs.dataset.converter">
<!ENTITY author      "MajorPain007">
<!ENTITY version     "2025.04.12">
<!ENTITY launch      "Settings/ZFSDatasetConverter">
<!ENTITY pluginURL   "https://raw.githubusercontent.com/MajorPain007/zfs-dataset-converter/main/src/zfs.dataset.converter.plg">
<!ENTITY pkgURL      "https://raw.githubusercontent.com/MajorPain007/zfs-dataset-converter/main/build">
<!ENTITY pluginDir   "/usr/local/emhttp/plugins/&name;">
<!ENTITY configDir   "/boot/config/plugins/&name;">
<!ENTITY tmpDir      "/tmp/&name;">
]>

<PLUGIN name="&name;" author="&author;" version="&version;" launch="&launch;"
        pluginURL="&pluginURL;"
        min="6.12.0"
        icon="database">

<CHANGES>
## Version 2025.04.12
- Add automatic schedule (cron) with hourly/6h/daily/weekly/custom options
- Cron job auto-restored on reboot via rc.d script
- Fix cron settings not persisting after page reload
- Fix plugin update via Unraid GUI (versioned txz package)
- Fix HTML entity encoding in log viewer (&amp;#039; → ')
- Fix "Error" status badge when nothing to convert

## Version 2025.04.11
- Initial release
- Convert regular folders to ZFS child datasets
- Docker container and VM awareness (auto stop/start)
- Resume interrupted conversions
- Dry-run mode
- Real-time log viewer
- Unraid notification support
</CHANGES>

<!-- Create required directories -->
<FILE Run="/bin/bash">
<INLINE>
mkdir -p &configDir;
mkdir -p &tmpDir;
</INLINE>
</FILE>

<!-- Download and install versioned plugin package (guaranteed fresh on each version bump) -->
<FILE Name="&configDir;/&name;-&version;.txz" Run="upgradepkg --install-new">
<URL>&pkgURL;/&name;-&version;.txz</URL>
<MD5>af65ab43c44744b7b69e92166a7be3b9</MD5>
</FILE>

<!-- rc.d script for boot persistence of cron job -->
<FILE Name="/etc/rc.d/rc.zfs-dataset-converter" Mode="755">
<INLINE>
#!/bin/bash
# Restore ZFS Dataset Converter cron job after boot
/usr/local/emhttp/plugins/zfs.dataset.converter/scripts/setup_cron.sh &gt;/tmp/zfs.dataset.converter/setup_cron.log 2&gt;&amp;1
</INLINE>
</FILE>

<!-- Write default config if not present, then apply cron -->
<FILE Run="/bin/bash">
<INLINE>
if [ ! -f &configDir;/settings.cfg ]; then
cat &gt; &configDir;/settings.cfg &lt;&lt; 'SETTINGS_EOF'
# ZFS Dataset Converter - default settings
dry_run=yes
cleanup=yes
replace_spaces=no
should_process_containers=yes
appdata_pool=cache
appdata_dataset=appdata
should_process_vms=no
vm_pool=cache
vm_dataset=domains
vm_forceshutdown_wait=90
buffer_zone=11
send_notifications=yes
validation_tolerance=5
extra_datasets=
cron_enabled=no
cron_preset=daily
cron_hour=2
cron_minute=0
cron_weekday=0
cron_custom=0 2 * * *
SETTINGS_EOF
fi

# Apply cron from saved settings
/usr/local/emhttp/plugins/zfs.dataset.converter/scripts/setup_cron.sh &gt;&amp;1
</INLINE>
</FILE>

<!-- Uninstall -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
rm -f /etc/cron.d/&name;
rm -f /etc/rc.d/rc.zfs-dataset-converter
[ -f /var/run/crond.pid ] &amp;&amp; kill -HUP "$(cat /var/run/crond.pid)" 2&gt;/dev/null
removepkg &configDir;/&name;-&version;.txz 2&gt;/dev/null || rm -rf &pluginDir;
rm -rf &tmpDir;
echo "ZFS Dataset Converter removed. Settings in &configDir; preserved."
</INLINE>
</FILE>

</PLUGIN>
