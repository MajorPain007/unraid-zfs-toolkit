    <!-- Status -->
    <div style="margin-top:12px;margin-left:20px;display:flex;flex-wrap:wrap;gap:16px;font-size:12px;color:#8b949e;">
      <span>Cron: <span id="snap-cron-badge" style="font-family:monospace;color:#e3b341;">—</span></span>
