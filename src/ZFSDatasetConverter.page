<script>
var _pollInterval = null;
var _logFile = null;
var _logOffset = 0;
var _pluginBase = '/plugins/zfs.dataset.converter/scripts';

function toggleSection(id, show) {
  document.getElementById(id).style.display = show ? '' : 'none';
}

function getFormData() {
  var f = document.getElementById('settings-form');
  var bools = ['dry_run','cleanup','replace_spaces','send_notifications',
               'should_process_containers','should_process_vms'];
  var data = {};
  bools.forEach(function(n) {
    data[n] = f.elements[n] && f.elements[n].checked ? 'yes' : 'no';
  });
  ['buffer_zone','validation_tolerance','appdata_pool','appdata_dataset',
   'vm_pool','vm_dataset','vm_forceshutdown_wait','extra_datasets'].forEach(function(n) {
    if (f.elements[n]) data[n] = f.elements[n].value;
  });
  return data;
}

function saveSettings() {
  var data = getFormData();
  fetch(_pluginBase + '/save_settings.php', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify(data)
  })
  .then(function(r){ return r.json(); })
  .then(function(res) {
    var el = document.getElementById('save-result');
    if (res.success) {
      el.style.color = '#56d364';
      el.textContent = 'Settings saved.';
      updateDryRunBanner();
    } else {
      el.style.color = '#f85149';
      el.textContent = 'Error: ' + (res.error || 'unknown');
    }
    setTimeout(function(){ el.textContent = ''; }, 3000);
  });
}

function updateDryRunBanner() {
  var cb = document.getElementById('dry_run');
  var banner = document.getElementById('dry-run-banner');
  banner.style.display = cb && cb.checked ? 'block' : 'none';
}

function scanFolders() {
  var spinner = document.getElementById('scan-spinner');
  spinner.style.display = 'inline';
  var data = getFormData();
  fetch(_pluginBase + '/scan_folders.php', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify(data)
  })
  .then(function(r){ return r.json(); })
  .then(function(res) {
    spinner.style.display = 'none';
    renderFolderTable(res);
  })
  .catch(function() {
    spinner.style.display = 'none';
    document.getElementById('folder-list').innerHTML =
      '<p style="color:#f85149;">Error scanning folders.</p>';
  });
}

function renderFolderTable(res) {
  var el = document.getElementById('folder-list');
  if (!res || !res.sources || res.sources.length === 0) {
    el.innerHTML = '<p style="color:#8b949e; font-size:13px;">No sources configured or no entries found.</p>';
    return;
  }
  var html = '';
  res.sources.forEach(function(src) {
    html += '<p style="font-weight:600; color:#79c0ff; margin:10px 0 6px 0;">' +
             escHtml(src.path) + '</p>';
    if (!src.entries || src.entries.length === 0) {
      html += '<p style="color:#8b949e; font-size:13px; margin:0 0 8px 16px;">No entries found.</p>';
      return;
    }
    html += '<table id="folder-table"><thead><tr>' +
            '<th>Name</th><th>Type</th><th>Size</th></tr></thead><tbody>';
    src.entries.forEach(function(e) {
      var typeClass = e.type === 'dataset' ? 'tag-dataset' : 'tag-folder';
      var typeLabel = e.type === 'dataset' ? 'Dataset' : 'Folder (will convert)';
      html += '<tr><td>' + escHtml(e.name) + '</td>' +
              '<td class="' + typeClass + '">' + typeLabel + '</td>' +
              '<td>' + escHtml(e.size) + '</td></tr>';
    });
    html += '</tbody></table>';
  });
  el.innerHTML = html;
}

function escHtml(s) {
  return String(s)
    .replace(/&/g,'&amp;').replace(/</g,'&lt;')
    .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function startConversion() {
  clearLog();
  _logOffset = 0;
  var data = getFormData();

  document.getElementById('btn-start').disabled = true;
  document.getElementById('btn-stop').style.display = 'inline-block';
  setStatus('running', 'Running');
  appendLog('Starting conversion...\n', 'log-step');

  fetch(_pluginBase + '/start_conversion.php', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify(data)
  })
  .then(function(r){ return r.json(); })
  .then(function(res) {
    if (res.success) {
      _logFile = res.log_file;
      appendLog('Process started (PID ' + res.pid + ')\n', 'log-ok');
      startPolling();
    } else {
      appendLog('ERROR: ' + (res.error || 'Could not start conversion') + '\n', 'log-error');
      setStatus('error', 'Error');
      document.getElementById('btn-start').disabled = false;
      document.getElementById('btn-stop').style.display = 'none';
    }
  })
  .catch(function(e) {
    appendLog('ERROR: ' + e + '\n', 'log-error');
    setStatus('error', 'Error');
    document.getElementById('btn-start').disabled = false;
    document.getElementById('btn-stop').style.display = 'none';
  });
}

function stopConversion() {
  fetch(_pluginBase + '/get_status.php?action=stop', {method:'POST'})
    .then(function(){ appendLog('\nStop requested.\n', 'log-warn'); });
}

function startPolling() {
  if (_pollInterval) clearInterval(_pollInterval);
  _pollInterval = setInterval(pollStatus, 1500);
}

function stopPolling() {
  if (_pollInterval) { clearInterval(_pollInterval); _pollInterval = null; }
}

function pollStatus() {
  var url = _pluginBase + '/get_status.php';
  fetch(url)
  .then(function(r){ return r.json(); })
  .then(function(res) {
    if (_logFile) fetchNewLogs();
    if (res.status === 'completed') {
      stopPolling();
      setStatus('done', 'Done');
      document.getElementById('btn-start').disabled = false;
      document.getElementById('btn-stop').style.display = 'none';
      scanFolders();
    } else if (res.status === 'error') {
      stopPolling();
      setStatus('error', 'Error');
      document.getElementById('btn-start').disabled = false;
      document.getElementById('btn-stop').style.display = 'none';
    }
    if (res.current_folder) {
      document.getElementById('progress-text').textContent = 'Processing: ' + res.current_folder;
    }
  });
}

function fetchNewLogs() {
  fetch(_pluginBase + '/get_logs.php?file=' + encodeURIComponent(_logFile) + '&offset=' + _logOffset)
  .then(function(r){ return r.json(); })
  .then(function(res) {
    if (res.lines && res.lines.length > 0) {
      res.lines.forEach(function(line) {
        var cls = '';
        if (/ERROR|FAILED|VALIDATION FAILED/.test(line)) cls = 'log-error';
        else if (/WARNING/.test(line))                    cls = 'log-warn';
        else if (/^=== Step/.test(line))                  cls = 'log-step';
        else if (/\bOK:/.test(line))                      cls = 'log-ok';
        appendLog(line + '\n', cls);
      });
      _logOffset = res.next_offset;
    }
  });
}

function appendLog(text, cls) {
  var el = document.getElementById('log-viewer');
  var span = document.createElement('span');
  if (cls) span.className = cls;
  span.textContent = text;
  el.appendChild(span);
  el.scrollTop = el.scrollHeight;
}

function clearLog() {
  document.getElementById('log-viewer').innerHTML = '';
}

function setStatus(type, label) {
  var el = document.getElementById('status-badge');
  el.className = '';
  el.classList.add('badge-' + type);
  el.textContent = label;
}

// Init
document.addEventListener('DOMContentLoaded', function() {
  updateDryRunBanner();
  document.getElementById('dry_run').addEventListener('change', updateDryRunBanner);

  // Check if a conversion is already running
  fetch(_pluginBase + '/get_status.php')
  .then(function(r){ return r.json(); })
  .then(function(res) {
    if (res.status === 'running') {
      _logFile = res.log_file;
      setStatus('running', 'Running');
      document.getElementById('btn-start').disabled = true;
      document.getElementById('btn-stop').style.display = 'inline-block';
      startPolling();
    }
  });
});
</script>
